# Copy this file to .env.local (gitignored) and fill in your keys.
# The bench CLIs (`npm run bench`, `npm run grade`) load .env.local automatically.
# An explicit `export VAR=...` in your shell always overrides these.

# DeepSeek — for `--agent=deepseek` and the offline judge (`npm run grade`)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional DeepSeek overrides:
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic — for `--agent=llm`
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Portal (OpenAI-compatible aggregator, e.g. yi-zhan) — one endpoint fronting many model families.
# Powers the cross-model panel: --agent=claude-opus-4-8-thinking | gemini-3.5-flash | glm-5.2 | kimi-k2.6 | MiniMax-M2.7
# (agent id === model name). Needed to reproduce the multi-model decorrelation / three-arm figure.
# GEMINI_BASE_URL=https://vip.yi-zhan.top
# GEMINI_API_KEY=your-portal-key-here
