{
  "name": "red-dust-mvp-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "bench": "esbuild bench/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/cli.mjs --log-level=warning && node .bench/cli.mjs",
    "bench:win": "esbuild bench/winnability.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/win.mjs --log-level=warning && node .bench/win.mjs",
    "play": "esbuild bench/play.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/play.mjs --log-level=warning && node .bench/play.mjs",
    "bench:items": "esbuild bench/validate-items.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/items.mjs --log-level=warning && node .bench/items.mjs",
    "bench:commitments": "esbuild bench/validate-commitments.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/commitments.mjs --log-level=warning && node .bench/commitments.mjs",
    "bench:vent": "esbuild bench/validate-vent.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/vent.mjs --log-level=warning && node .bench/vent.mjs",
    "bench:probes": "esbuild bench/validate-probes.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/probes.mjs --log-level=warning && node .bench/probes.mjs",
    "bench:relationship": "esbuild bench/validate-relationship.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/relationship.mjs --log-level=warning && node .bench/relationship.mjs",
    "grade": "esbuild bench/grade-comprehension.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/grade.mjs --log-level=warning && node .bench/grade.mjs",
    "grade:integrity": "esbuild bench/grade-integrity.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/grade-integrity.mjs --log-level=warning && node .bench/grade-integrity.mjs",
    "bench:compare": "esbuild bench/compare.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/compare.mjs --log-level=warning && node .bench/compare.mjs",
    "bench:trace": "esbuild bench/export-trace.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/trace.mjs --log-level=warning && node .bench/trace.mjs",
    "gen:items": "esbuild bench/gen-items.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/gen-items.mjs --log-level=warning && node .bench/gen-items.mjs",
    "bench:decorrelate": "esbuild bench/decorrelation.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/decorrelate.mjs --log-level=warning && node .bench/decorrelate.mjs",
    "bench:sensitivity": "esbuild bench/sensitivity.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/sensitivity.mjs --log-level=warning && node .bench/sensitivity.mjs",
    "bench:rc": "esbuild bench/release-candidate.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/rc.mjs --log-level=warning && node .bench/rc.mjs",
    "bench:three-arm": "esbuild bench/three-arm.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/three-arm.mjs --log-level=warning && node .bench/three-arm.mjs",
    "bench:kappa-pack": "esbuild bench/kappa-pack.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/kappa-pack.mjs --log-level=warning && node .bench/kappa-pack.mjs",
    "bench:kappa-score": "esbuild bench/kappa-score.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/kappa-score.mjs --log-level=warning && node .bench/kappa-score.mjs",
    "build": "tsc -b && vite build",
    "dev:web": "vite --config web/vite.config.ts",
    "sync:traces": "cp bench/fixtures/traces/*.trace.json web/public/traces/",
    "sync:decorrelation": "cp bench/fixtures/decorrelation/red-dust-v2-authoritative.json web/public/decorrelation/",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "smoke:web": "npm run build:web && node scripts/browser-smoke-web.mjs",
    "hero:gif": "npm run build:web && node scripts/export-hero-gif.mjs",
    "figure1": "npm run build:web && node scripts/capture-figure1.mjs",
    "deploy:check": "npm run build:web && node scripts/serve-subpath-sim.mjs",
    "play:human": "esbuild scripts/play-human.ts --bundle --platform=node --format=esm --packages=external --outfile=.bench/play-human.mjs --log-level=warning && node .bench/play-human.mjs",
    "generate:story-art": "node scripts/generate-story-art.mjs",
    "validate:script": "node scripts/validate-script-upgrade.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@observablehq/plot": "^0.6.17",
    "@vitejs/plugin-react": "^5.0.0",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.3"
  }
}
